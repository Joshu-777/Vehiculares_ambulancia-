<?xml version="1.0" encoding="UTF-8"?>
<additional>
    <!-- Auto: comportamiento normal -->
    <vType id="car" vClass="passenger"
           accel="2.6" decel="4.5" sigma="0.5" tau="1.0"
           length="4.5" minGap="2.5" maxSpeed="50"
           color="0.8,0.8,0.8"/>

    <!-- Bus: 12 m, más lento y conservador -->
    <vType id="bus" vClass="bus"
           accel="1.2" decel="3.0" sigma="0.5" tau="1.2"
           length="12.0" minGap="3.0" maxSpeed="40"
           color="0,0,1"/>

    <!-- Moto: agresiva, minGap pequeño -->
    <vType id="moto" vClass="motorcycle"
           accel="3.5" decel="5.0" sigma="0.5" tau="1.0"
           length="2.0" minGap="1.0" maxSpeed="60"
           color="1,0,1"/>

    <!-- Ambulancia: emergencia, guiShape emergencia -->
    <vType id="ambulance" vClass="emergency" guiShape="emergency"
           accel="2.8" decel="4.5" sigma="0.5" tau="1.0"
           length="6.0" minGap="2.0" maxSpeed="70"
           speedFactor="1.3"
           color="1,1,1"/>
</additional>
